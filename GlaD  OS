def timestamp():
    return datetime.now(ZoneInfo("Asia/Riyadh")).strftime("%H:%M:%S")


def run_chat_client():
    print(chatroom_banner)
    HOST = input("Enter server IP (leave blank for 127.0.0.1): ") or '127.0.0.1'
    PORT = 5555

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect((HOST, PORT))

    msg = client.recv(1024).decode('utf-8')
    if msg == "USERNAME":
        username = input("Enter your username: ")
        client.send(username.encode('utf-8'))

    msg = client.recv(1024).decode('utf-8')
    if msg == "PASSWORD":
        password = input("Enter the group password: ")
        client.send(password.encode('utf-8'))

    msg = client.recv(1024).decode('utf-8')
    if msg == "WRONG_PASSWORD":
        print("Incorrect password. Disconnecting.")
        client.close()
        return
    else:
        print(msg)

    print("Type '/leave' at any time to exit the chat and return to GLaD OS.")

    stop_flag = threading.Event()

    def receive():
        while not stop_flag.is_set():
            try:
                message = client.recv(1024).decode('utf-8')
                if not message:
                    break
                print(message)
            except:
                break

    def write():
        while True:
            text = input('')
            if text.strip() == "/leave":
                print("Leaving chat...")
                stop_flag.set()
                try:
                    client.close()
                except:
                    pass
                break
            message = f"[{timestamp()}] {username} : {text}"
            print(message)
            try:
                client.send(message.encode('utf-8'))
            except:
                break

    receive_thread = threading.Thread(target=receive)
    write_thread = threading.Thread(target=write)

    receive_thread.start()
    write_thread.start()

    # Block here until the user types /leave, so we don't return to the
    # main menu while these threads are still running in the background.
    write_thread.join()
    stop_flag.set()
    try:
        client.close()
    except:
        pass
    receive_thread.join(timeout=1)

    print("Returned to GLaD OS.")


