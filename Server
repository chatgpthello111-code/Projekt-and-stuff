import socket
import threading
from datetime import datetime
from zoneinfo import ZoneInfo

HOST = '0.0.0.0'
PORT = 5555
PASSWORD = "talk"

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind((HOST, PORT))
server.listen()

clients = []
usernames = []

def timestamp():
    return datetime.now(ZoneInfo("Asia/Riyadh")).strftime("%H:%M:%S")

def broadcast(message, sender_socket=None):
    for client in clients:
        if client != sender_socket:
            try:
                client.send(message)
            except:
                pass

def handle_client(client):
    while True:
        try:
            message = client.recv(1024)
            if not message:
                break
            print(message.decode('utf-8'))
            broadcast(message, client)
        except:
            break

    if client in clients:
        index = clients.index(client)
        clients.remove(client)
        username = usernames[index]
        usernames.remove(username)
        broadcast(f"[{timestamp()}] {username} has left the chat.".encode('utf-8'))
    client.close()

def receive_connections():
    print(f"Server started on {HOST}:{PORT}, waiting for connections...")
    while True:
        client, address = server.accept()
        print(f"Connected with {address}")

        client.send("USERNAME".encode('utf-8'))
        username = client.recv(1024).decode('utf-8')

        client.send("PASSWORD".encode('utf-8'))
        entered_password = client.recv(1024).decode('utf-8')

        if entered_password != PASSWORD:
            client.send("WRONG_PASSWORD".encode('utf-8'))
            client.close()
            print(f"{username} entered the wrong password, connection rejected.")
            continue

        client.send("PASSWORD_OK".encode('utf-8'))

        usernames.append(username)
        clients.append(client)

        print(f"Username of client is {username}")
        broadcast(f"[{timestamp()}] {username} has joined the chat!".encode('utf-8'))
        client.send("Connected to the group chat!".encode('utf-8'))

        thread = threading.Thread(target=handle_client, args=(client,))
        thread.start()

receive_connections()
